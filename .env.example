# Copy to .env and fill in
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Auth (optional: generated into data/jwt_secrets.json if blank)
# python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PKR per 1 USD (update when the rate moves)
PKR_PER_USD=280

# Meta OAuth (optional; token can also be pasted in the Meta tab)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
APP_BASE_URL=http://localhost:8000

# Monitoring: how often launched campaigns are checked
MONITOR_INTERVAL_HOURS=3

# AI creatives (same as the Social Agent). Default: higgsfield = the team's Higgsfield plan credits,
# connected once with the "Connect Higgsfield" button in the Meta tab (no API key).
# Alternatives: gemini or openai with IMAGE_API_KEY.
IMAGE_PROVIDER=higgsfield
IMAGE_API_KEY=
IMAGE_MODEL=
HIGGSFIELD_MODEL=gpt_image_2_5
HIGGSFIELD_VARIANT=sunburst
HIGGSFIELD_QUALITY=medium
HIGGSFIELD_RESOLUTION=1k
# Higgsfield takes the product photo by public URL: the Social Agent's R2 bucket (public) works.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email alerts (same as the Social Agent): Gmail API first, Brevo when Gmail is not set up or refuses.
ALERT_EMAIL=you@example.com
ALERT_MIN_SEVERITY=warning
DIGEST_WEEKDAY=0               # weekly digest email: 0 = Monday ... 6 = Sunday

# Gmail API: the Google OAuth client (Desktop app, Gmail API enabled; the Social Agent's works).
# Then press "Connect Gmail" in the Meta tab: the sign-in is stored in the app (encrypted).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Brevo fallback (brevo.com, free): an API key and a sender verified in Brevo.
BREVO_API_KEY=
ALERT_FROM=